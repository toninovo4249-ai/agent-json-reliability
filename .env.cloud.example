# Cloud HTTP only. MCP stdio does not read this file.
HOST=0.0.0.0
PUBLIC_BETA_CONFIRM=true
FREE_BETA=true
X402_PAYMENT_ENABLED=false
PAID_ROUTE_ENABLED=false
MAINNET_PAYMENT_ENABLED=false
FIRST_PAID_BUYER_MODE=true
SELLER_SPEND_ALLOWED=false
# Operator-controlled Base receive address only. Never a private key.
# SELLER_RECEIVE_ADDRESS=
X402_NETWORK=eip155:8453
X402_USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_PRICE_ATOMIC=3000
PAID_PRICE_USDC=0.003
# CDP facilitator JWT (not a wallet). Set as Render secrets, never commit:
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET is NOT required for seller verify/settle. Do not set a seed/private key.
# Set after deploy to the durable HTTPS origin (never trycloudflare):
# PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
