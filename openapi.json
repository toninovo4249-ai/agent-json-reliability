    "x-llm-required": false,
    "x-guidance": "Free routes: GET /health, POST /v1/json/inspect, POST /v1/json/validate, POST /v1/json/repair, POST /mcp. Paid route: POST /v1/json/reliable. Unpaid calls return HTTP 402. Body: {\"text\": \"<json or malformed json>\", \"schema\": {optional JSON Schema}}."
